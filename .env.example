# Copy this file to .env in the directory where you run sss.
# Fill only the sources you use. Empty values disable JSON fallback for that field.

# Canvas: oc.sjtu.edu.cn -> Account -> Settings -> access token.
# Paste the raw token, without the "Bearer " prefix.
SSS_CANVAS_TOKEN=''

# Share: log in to share.dyweb.sjtu.cn, then read localStorage key "token".
# Paste the raw value used by the API's Auth header, without JSON quotes.
SSS_SHARE_TOKEN=''

# Reviews: course.sjtu.plus -> Cookies -> jcourse_session.
# Paste only the raw jcourse_session value; the cookie name is added automatically.
# Existing "jcourse_session=...; csrftoken=..." format is also supported.
SSS_REVIEWS_COOKIE=''
